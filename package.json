{
  "name": "kvali-tests",
  "private": true,
  "description": "Local-only Anchor program tests for Kvali (LiteSVM, in-process; never touches devnet)",
  "scripts": {
    "test": "TS_NODE_PROJECT=./tsconfig.json node --no-experimental-strip-types --no-allocation-site-pretenuring node_modules/mocha/lib/cli/cli.js --require ts-node/register --extension ts -t 1000000 'tests/**/*.ts'",
    "demo:devnet": "ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-https://api.devnet.solana.com} ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} TS_NODE_PROJECT=./tsconfig.json ts-node --transpile-only scripts/devnet-demo.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.4",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "chai": "4.5.0",
    "litesvm": "0.8.0",
    "mocha": "10.8.2",
    "ts-mocha": "10.1.0",
    "typescript": "5.7.3"
  }
}
